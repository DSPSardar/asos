# ─────────────────────────────────────────────
# ASOS v1 — Environment Variables
# Copy this file to .env and fill in all values
# ─────────────────────────────────────────────

# ── SERVER ──────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ── DATABASE ─────────────────────────────────
DATABASE_URL="postgresql://asos_user:password@localhost:5432/asos_db?schema=public"

# ── DSP enrolment import source (Supabase Postgres) ───────────
# The dsp-mastery project on the DSP site. Reads public.mastery_enrol_requests
# over the REST endpoint, so this needs the service_role key — the anon key is
# blocked by RLS and will come back empty.
# Leave both blank to disable the Sync button.
DSP_SUPABASE_URL=https://<project-ref>.supabase.co
DSP_SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ── REDIS ────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ──────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_key_change_in_production_min_64_chars
JWT_REFRESH_EXPIRES_IN=7d

# ── READ-ONLY API KEY (SARDAR showcase page) ──
# Enables GET-only access with X-API-Key to a short allow-list of routes
# (see backend/src/middleware/readApiKey.js). Leave both unset to disable.
# Generate a long random value yourself; never commit or log it.
# ASOS_READ_API_KEY=
# Tenant whose data the key reads (the DSP tenant in production).
# ASOS_READ_API_TENANT_ID=

# ── WHATSAPP CLOUD API (Meta) ─────────────────
# Get from: developers.facebook.com → Your App → WhatsApp
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token

# ── OPENAI (sales agents + Content Studio images) ─
OPENAI_API_KEY=sk-your-openai-api-key

# ── MODELS (registry: backend/src/config/models.js) ──
# Every model ID production uses is resolved there; these are the overrides.
# A weekly job (Mondays 08:00 PKT) probes each configured model and alerts
# the Mastery tenant admin on 404 / deprecation.
# WhatsApp sales agent (OpenAI):
OPENAI_MODEL=gpt-5.4-mini
# OPENAI_QUALIFIER_MODEL=
# OPENAI_CLOSER_MODEL=
# OPENAI_TRANSCRIPTION_MODEL=whisper-1
# OPENAI_IMAGE_MODEL=gpt-image-1
# Content Studio ad copy (Anthropic). ANTHROPIC_MODEL wins; CLAUDE_MODEL and
# CLOSER_MODEL are legacy names for the same override.
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
# ANTHROPIC_MODEL=claude-sonnet-5
# QUALIFIER_MODEL=claude-haiku-4-5        # Content Studio brand analysis
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
CLAUDE_MAX_TOKENS=512
CLAUDE_TEMPERATURE=0.3

# ── DSP AI AGENT MASTERY ─────────────────────
# MASTERY_TENANT_ID also switches on the code guards for that tenant: the AI
# can never set CLOSED_WON (only the /webhooks/mastery enrolment event or a
# human can), and the 15-minute backlog sweep answers unanswered threads.
# MASTERY_TENANT_ID=
# MASTERY_ENROL_URL=https://digitalservicesprogram.com/api/mastery/enrol
# MASTERY_ENROL_SECRET=
# MASTERY_EVENTS_SECRET=

# ── META CONVERSIONS API ─────────────────────
META_API_VERSION=v20.0
META_API_URL=https://graph.facebook.com

# ── CONTENT STUDIO IMAGES ─────────────────────
# Primary image provider: openai | replicate | pollinations
# Default when unset: openai if OPENAI_API_KEY is set, else replicate if
# REPLICATE_API_TOKEN is set, else pollinations (free, no token).
# If the chosen provider fails, the service falls back to the next one.
# IMAGE_PROVIDER=openai
# OpenAI gpt-image-1 quality: low | medium | high | auto (default: medium)
# OPENAI_IMAGE_QUALITY=medium
# Replicate (optional): REPLICATE_API_TOKEN enables it; override the model with REPLICATE_MODEL.
# REPLICATE_MODEL=black-forest-labs/flux-dev
# REPLICATE_API_TOKEN=r8_...
# Optional: public API origin so JSON includes absolute image URLs (Apache may only proxy /api).
# PUBLIC_UPLOADS_BASE=https://api.yourdomain.com

# ── STRIPE ───────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ── EMAIL (Resend) ────────────────────────────
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com
PASSWORD_RESET_URL=https://asos-kappa.vercel.app/reset-password
APP_URL=https://asos-kappa.vercel.app

# ── STORAGE (S3-compatible) ──────────────────
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=asos-media
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_REGION=us-east-1

# ── CORS ─────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3001,https://app.yourdomain.com

# ── LOGGING ──────────────────────────────────
LOG_LEVEL=info
