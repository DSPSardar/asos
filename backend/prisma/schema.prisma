// This is your Prisma schema file
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum TenantPlan {
  FREE
  PRO
  ENTERPRISE
}

enum TenantStatus {
  PENDING_APPROVAL
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum UserRole {
  SUPERADMIN
  TENANT_ADMIN
  AGENT
}

enum LeadStage {
  NEW
  QUALIFYING
  DIAGNOSED
  PROPOSED
  CLOSED_WON
  CLOSED_LOST
}

enum LeadScore {
  HOT
  WARM
  COLD
}

enum ConversationStatus {
  ACTIVE
  AI_HANDLING
  HUMAN_TAKEOVER
  // Lead has sent payment proof; a human must verify it before the seat is
  // confirmed. Distinct from HUMAN_TAKEOVER so the inbox can surface "money
  // is waiting on you" separately from ordinary escalations.
  PENDING_VERIFICATION
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSender {
  CONTACT
  AI
  AGENT
  SYSTEM
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  DOCUMENT
  TEMPLATE
  INTERACTIVE
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum LeadBusinessUnit {
  DSP
  SDC
  UNKNOWN
}

enum ContentDraftStatus {
  GENERATED
  SAVED
  SKIPPED
  PUBLISHED
  SENT_FOR_APPROVAL
}

enum ActivityType {
  NOTE
  STAGE_CHANGE
  AI_ACTION
  CALL
  EMAIL
  SYSTEM
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

// Review state for a bank-transfer payment a tenant claims to have made.
// Distinct from SubscriptionStatus: this tracks one payment, not the
// subscription it pays for.
enum ManualPaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────
// TENANTS — Core multi-tenant entity
// ─────────────────────────────────────────────

model Tenant {
  id              String       @id @default(uuid())
  slug            String       @unique
  name            String
  plan            TenantPlan   @default(FREE)
  status          TenantStatus @default(TRIAL)

  // WhatsApp Cloud API credentials (encrypted at app layer)
  waPhoneId       String?      @map("wa_phone_id")
  waAccessToken   String?      @map("wa_access_token")
  waAppSecret     String?      @map("wa_app_secret")
  waVerifyToken   String?      @map("wa_verify_token")

  // Meta Ads / Conversions API
  metaPixelId       String?    @map("meta_pixel_id")
  metaAccessToken   String?    @map("meta_access_token")
  metaAdAccountId   String?    @map("meta_ad_account_id")

  // Stripe billing
  stripeCustomerId  String?    @map("stripe_customer_id")

  // Settings (JSON blob for extensibility)
  settings        Json         @default("{}")

  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  users           User[]
  contacts        Contact[]
  leads           Lead[]
  conversations   Conversation[]
  messages        Message[]
  campaigns       Campaign[]
  activities      Activity[]
  inboundMedia    InboundMedia[]
  aiConfig        AiConfig?
  subscription    Subscription?
  adsTracking     AdsTracking[]
  brandProfiles   BrandProfile[]
  contentSessions ContentSession[]
  contentDrafts   ContentDraft[]
  clientReports   ClientReport[]
  knowledgeGaps   KnowledgeGap[]
  manualPayments  ManualPayment[]

  @@map("tenants")
}

// ─────────────────────────────────────────────
// USERS — Agents, Admins, Superadmin
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(uuid())
  tenantId      String?   @map("tenant_id")   // null = SUPERADMIN
  email         String    @unique
  passwordHash  String?   @map("password_hash")
  googleId      String?   @unique @map("google_id")
  role          UserRole  @default(AGENT)
  fullName      String    @map("full_name")
  avatarUrl     String?   @map("avatar_url")
  isActive      Boolean   @default(true) @map("is_active")
  lastLoginAt   DateTime? @map("last_login_at")

  // Refresh token (hashed, stored for revocation)
  refreshTokenHash  String?  @map("refresh_token_hash")

  // One-time password reset token (only the SHA-256 hash is stored)
  passwordResetTokenHash String?   @map("password_reset_token_hash")
  passwordResetExpiresAt DateTime? @map("password_reset_expires_at")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant        Tenant?   @relation(fields: [tenantId], references: [id])
  assignedLeads Lead[]    @relation("AgentLeads")
  activities    Activity[]

  @@index([passwordResetTokenHash])
  @@map("users")
}

// ─────────────────────────────────────────────
// CONTACTS — People who sent a WA message
// ─────────────────────────────────────────────

model Contact {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  phone         String    // E.164 format e.g. +5511999999999
  name          String?
  email         String?
  waProfilePic  String?   @map("wa_profile_pic")
  city          String?
  ageGroup      String?   @map("age_group")   // e.g. "18-24", "25-30", "31-35", "36+"
  tags          String[]  @default([])
  customFields  Json      @default("{}") @map("custom_fields")
  optIn         Boolean   @default(false) @map("opt_in")
  sentWelcomeVoice Boolean @default(false) @map("sent_welcome_voice")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  leads         Lead[]
  conversations Conversation[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("contacts")
}

// ─────────────────────────────────────────────
// LEADS — CRM core record
// ─────────────────────────────────────────────

model Lead {
  id                  String     @id @default(uuid())
  tenantId            String     @map("tenant_id")
  contactId           String     @map("contact_id")
  campaignId          String?    @map("campaign_id")
  assignedTo          String?    @map("assigned_to")

  stage               LeadStage  @default(NEW)
  scoreLabel          LeadScore  @default(COLD) @map("score_label")
  aiScore             Int        @default(0) @map("ai_score")   // 0-100
  dealValue           Decimal?   @map("deal_value") @db.Decimal(12, 2)
  currency            String     @default("BRL")
  lostReason          String?    @map("lost_reason")

  // AI-extracted qualification data (BANT + problem diagnosis)
  qualificationData   Json       @default("{}") @map("qualification_data")

  // ── v1.5 — Dual AI agent fields ──
  intent                  String?    // "high" | "medium" | "low" — from Qualifier AI
  problemSummary          String?    @map("problem_summary")
  nextAction              String?    @map("next_action")
  humanFollowupRequired   Boolean    @default(false) @map("human_followup_required")
  leadTemperature         String?    @default("WARM") @map("lead_temperature")

  // Meta Ads attribution
  metaAdId            String?    @map("meta_ad_id")
  metaAdsetId         String?    @map("meta_adset_id")
  metaCampaignId      String?    @map("meta_campaign_id")
  sourceUtm           Json       @default("{}") @map("source_utm")

  // Business unit classification (set by Qualifier AI on first message)
  businessUnit        LeadBusinessUnit  @default(UNKNOWN) @map("business_unit")

  // ── DSP EdTech fields ──
  dspPhase            String?    @map("dsp_phase")      // LEARN | BUILD | EARN
  enrollmentFee       Decimal?   @db.Decimal(12,2) @map("enrollment_fee")

  closedAt            DateTime?  @map("closed_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  tenant              Tenant     @relation(fields: [tenantId], references: [id])
  contact             Contact    @relation(fields: [contactId], references: [id])
  campaign            Campaign?  @relation(fields: [campaignId], references: [id])
  agent               User?      @relation("AgentLeads", fields: [assignedTo], references: [id])
  conversations       Conversation[]
  activities          Activity[]
  adsTracking         AdsTracking[]

  @@index([tenantId, stage])
  @@index([tenantId, scoreLabel])
  @@index([tenantId, createdAt])
  @@index([tenantId, humanFollowupRequired])
  @@map("leads")
}

// ─────────────────────────────────────────────
// CONVERSATIONS — One per WA thread
// ─────────────────────────────────────────────

model Conversation {
  id                String               @id @default(uuid())
  tenantId          String               @map("tenant_id")
  leadId            String               @map("lead_id")
  contactId         String               @map("contact_id")
  waConversationId  String?              @map("wa_conversation_id")
  status            ConversationStatus   @default(ACTIVE)
  aiEnabled         Boolean              @default(true) @map("ai_enabled")
  handoffReason     String?              @map("handoff_reason")
  // Set the moment status flips to HUMAN_TAKEOVER (handleHandoff() in
  // conversation.worker.js is the single write point for that transition).
  // Without this, handoffReason existed but nothing recorded WHEN — so an
  // escalation SLA could not be measured even retroactively, since
  // updatedAt gets touched by any later change to the row, not just this one.
  handoffAt         DateTime?            @map("handoff_at")
  lastMessageAt     DateTime?            @map("last_message_at")

  // ── Payment proof tracking ──
  // paymentDetailsSentAt is what makes proof detection safe: an inbound image
  // only counts as payment proof if we actually asked this lead to pay. Without
  // it, any screenshot a lead sends — an ad, a meme, a CV — would mark them paid
  // and pull a human in.
  paymentDetailsSentAt DateTime?          @map("payment_details_sent_at")
  paymentProofDetected Boolean            @default(false) @map("payment_proof_detected")
  paymentProofAt       DateTime?          @map("payment_proof_at")

  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  tenant            Tenant               @relation(fields: [tenantId], references: [id])
  lead              Lead                 @relation(fields: [leadId], references: [id])
  contact           Contact              @relation(fields: [contactId], references: [id])
  messages          Message[]

  @@index([tenantId, status])
  @@index([tenantId, lastMessageAt])
  @@index([tenantId, paymentProofDetected])
  @@map("conversations")
}

// ─────────────────────────────────────────────
// MESSAGES — Every WA message in/out
// ─────────────────────────────────────────────

// Bytes of inbound WhatsApp media (images/video/documents), stored in
// Postgres rather than on a container's local disk. Railway's `asos`
// (serves this data) and `asos-worker` (downloads and writes it) are
// separate containers with separate, non-persistent filesystems — a file
// written by one is invisible to (and never durable on) the other. Storing
// the bytes in the database sidesteps that entirely: any service instance
// can read them, and they survive redeploys. See saveInboundMedia() in
// whatsapp.service.js and the GET /media/:id route in app.js.
model InboundMedia {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  mimeType  String   @map("mime_type")
  data      Bytes
  // SHA-256 of `data` — lets the payment-proof branch flag a screenshot the
  // same lead (or another lead of this tenant) already submitted.
  sha256    String?
  createdAt DateTime @default(now()) @map("created_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, sha256])
  @@map("inbound_media")
}

model Message {
  id               String           @id @default(uuid())
  tenantId         String           @map("tenant_id")
  conversationId   String           @map("conversation_id")
  waMessageId      String?          @unique @map("wa_message_id")
  direction        MessageDirection
  sender           MessageSender
  type             MessageType      @default(TEXT)
  content          String?
  mediaUrl         String?          @map("media_url")
  status           MessageStatus    @default(PENDING)
  aiTokensUsed     Int              @default(0) @map("ai_tokens_used")

  // Raw AI response stored for analytics
  aiRawResponse    Json?            @map("ai_raw_response")

  // Qualifier classification (inbound messages only)
  sentiment        String?                                    // POSITIVE | NEUTRAL | NEGATIVE
  signalType       String?          @map("signal_type")       // PRICING | INSTALLMENT | ... (see claude.service SIGNAL_TYPES)

  sentAt           DateTime         @default(now()) @map("sent_at")
  deliveredAt      DateTime?        @map("delivered_at")
  readAt           DateTime?        @map("read_at")

  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  conversation     Conversation     @relation(fields: [conversationId], references: [id])

  @@index([tenantId, conversationId])
  @@index([waMessageId])
  @@index([tenantId, direction, sentAt])
  @@map("messages")
}

// ─────────────────────────────────────────────
// CAMPAIGNS — Meta Ads campaign tracking
// ─────────────────────────────────────────────

model Campaign {
  id               String         @id @default(uuid())
  tenantId         String         @map("tenant_id")
  name             String
  metaCampaignId   String?        @map("meta_campaign_id")
  metaAdsetId      String?        @map("meta_adset_id")
  metaAdId         String?        @map("meta_ad_id")
  budget           Decimal?       @db.Decimal(12, 2)
  spend            Decimal        @default(0) @db.Decimal(12, 2)
  impressions      Int            @default(0)
  clicks           Int            @default(0)
  ctr              Float          @default(0)
  cpm              Float          @default(0)
  cpl              Float          @default(0)
  conversions      Int            @default(0)
  status           CampaignStatus @default(ACTIVE)
  startedAt        DateTime?      @map("started_at")
  endedAt          DateTime?      @map("ended_at")

  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  leads            Lead[]
  contentDrafts    ContentDraft[]

  @@index([tenantId])
  @@map("campaigns")
}

model BrandProfile {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  sourceUrl       String?   @map("source_url")
  sourceClientId  String?   @map("source_client_id")
  brandName       String?   @map("brand_name")
  tone            String?   @db.Text
  products        Json      @default("[]")
  audience        Json      @default("[]")
  colors          Json      @default("[]")
  logoUrl         String?   @map("logo_url")
  languageDefault String    @default("en") @map("language_default")
  rawExtraction   Json      @default("{}") @map("raw_extraction")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  contentSessions ContentSession[]
  contentDrafts   ContentDraft[]

  @@index([tenantId, createdAt])
  @@map("brand_profiles")
}

model ContentSession {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  brandProfileId  String?   @map("brand_profile_id")
  sourceUrl       String?   @map("source_url")
  sourceClientId  String?   @map("source_client_id")
  language        String    @default("en")
  generatedCount  Int       @default(0) @map("generated_count")
  swipeDecisions  Json      @default("{}") @map("swipe_decisions")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  brandProfile    BrandProfile? @relation(fields: [brandProfileId], references: [id])
  drafts          ContentDraft[]

  @@index([tenantId, createdAt])
  @@map("content_sessions")
}

model ContentDraft {
  id              String            @id @default(uuid())
  tenantId        String            @map("tenant_id")
  sessionId       String            @map("session_id")
  brandProfileId  String?           @map("brand_profile_id")
  campaignId      String?           @map("campaign_id")
  language        String            @default("en")
  channel         String
  subject         String?
  body            String            @db.Text
  imageUrl        String?           @map("image_url")
  palette         Json              @default("{}")
  status          ContentDraftStatus @default(GENERATED)
  metadata        Json              @default("{}")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  session         ContentSession    @relation(fields: [sessionId], references: [id])
  brandProfile    BrandProfile?     @relation(fields: [brandProfileId], references: [id])
  campaign        Campaign?         @relation(fields: [campaignId], references: [id])

  @@index([tenantId, sessionId])
  @@index([tenantId, status])
  @@map("content_drafts")
}

model ClientReport {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  periodType    String   @map("period_type")
  language      String   @default("en")
  reportFrom    DateTime @map("report_from")
  reportTo      DateTime @map("report_to")
  summary       String   @db.Text
  pdfPath       String?  @map("pdf_path")
  sentToPhone   String?  @map("sent_to_phone")
  sentAt        DateTime? @map("sent_at")
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("client_reports")
}

// ─────────────────────────────────────────────
// ADS TRACKING — Per-lead attribution
// ─────────────────────────────────────────────

model AdsTracking {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  leadId         String    @map("lead_id")
  metaCampaignId String?   @map("meta_campaign_id")
  metaAdsetId    String?   @map("meta_adset_id")
  metaAdId       String?   @map("meta_ad_id")
  utmSource      String?   @map("utm_source")
  utmMedium      String?   @map("utm_medium")
  utmCampaign    String?   @map("utm_campaign")
  utmContent     String?   @map("utm_content")
  utmTerm        String?   @map("utm_term")
  referrer       String?
  ipAddress      String?   @map("ip_address")

  // Meta Conversions API event tracking
  eventsSent     Json      @default("[]") @map("events_sent")

  createdAt      DateTime  @default(now()) @map("created_at")

  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  lead           Lead      @relation(fields: [leadId], references: [id])

  @@index([tenantId, metaCampaignId])
  @@map("ads_tracking")
}

// ─────────────────────────────────────────────
// ACTIVITIES — CRM activity timeline
// ─────────────────────────────────────────────

model Activity {
  id         String       @id @default(uuid())
  tenantId   String       @map("tenant_id")
  leadId     String       @map("lead_id")
  userId     String?      @map("user_id")
  type       ActivityType
  content    String
  metadata   Json         @default("{}")
  createdAt  DateTime     @default(now()) @map("created_at")

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  lead       Lead         @relation(fields: [leadId], references: [id])
  user       User?        @relation(fields: [userId], references: [id])

  @@index([tenantId, leadId])
  @@map("activities")
}

// ─────────────────────────────────────────────
// AI AGENT LOG — v1.5 dual-agent audit trail
// Stores raw Qualifier + Closer outputs for every message.
// Powers the future Analyst AI (v2).
// ─────────────────────────────────────────────

model AiAgentLog {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  leadId          String   @map("lead_id")
  conversationId  String   @map("conversation_id")
  messageId       String?  @map("message_id")          // inbound message that triggered this run

  // Qualifier AI output
  qualifierOutput Json     @map("qualifier_output")    // { lead_status, score, intent, problem_summary, next_action }
  qualifierTokens Int      @default(0) @map("qualifier_tokens")
  qualifierModel  String?  @map("qualifier_model")
  qualifierMs     Int      @default(0) @map("qualifier_ms")

  // Closer AI output
  closerOutput    Json?    @map("closer_output")       // { reply_message, closing_type, urgency_trigger }
  closerTokens    Int      @default(0) @map("closer_tokens")
  closerModel     String?  @map("closer_model")
  closerMs        Int      @default(0) @map("closer_ms")

  // Final routing decision after both agents
  finalAction     String?  @map("final_action")        // "send" | "handoff" | "close" | "skipped"
  errorReason     String?  @map("error_reason")

  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tenantId, leadId])
  @@index([tenantId, createdAt])
  @@index([conversationId])
  @@map("ai_agent_logs")
}

// ─────────────────────────────────────────────
// KNOWLEDGE GAPS — Questions AI couldn't answer
// Admin answers them → auto-injected into system prompt
// ─────────────────────────────────────────────

model KnowledgeGap {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  question    String    @db.Text          // The exact question the lead asked
  answer      String?   @db.Text          // Admin's answer (null = unanswered)
  timesAsked  Int       @default(1) @map("times_asked")
  resolved    Boolean   @default(false)   // true once admin has answered
  exampleLead String?   @map("example_lead") // contactId who asked (for context)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId, resolved])
  @@index([tenantId, createdAt])
  @@map("knowledge_gaps")
}

// ─────────────────────────────────────────────
// AI CONFIG — Per-tenant Claude configuration
// ─────────────────────────────────────────────

model AiConfig {
  id                    String    @id @default(uuid())
  tenantId              String    @unique @map("tenant_id")
  systemPrompt          String    @map("system_prompt") @db.Text
  qualificationCriteria Json      @default("[]") @map("qualification_criteria")
  closingScript         String?   @map("closing_script") @db.Text
  handoffTriggers       Json      @default("[]") @map("handoff_triggers")
  language              String    @default("pt-BR")
  model                 String    @default("claude-3-5-sonnet-20241022")
  temperature           Float     @default(0.3)
  maxTokens             Int       @default(512) @map("max_tokens")

  // Bank / payment instructions sent VERBATIM by the worker, never retyped by
  // the AI. Account numbers and IBANs must survive character-for-character, and
  // a generated reply is both length-capped and free to reword — neither is
  // acceptable for the details a lead uses to transfer money.
  paymentDetails        String?   @map("payment_details") @db.Text

  // Confirmation sent the moment a payment screenshot arrives, before any human
  // looks at it. Deterministic on purpose — the lead has just parted with money
  // and needs an immediate, correct acknowledgement, not a generated one.
  paymentProofMessage   String?   @map("payment_proof_message") @db.Text

  // ── v1.5 Settings UI fields ──
  tone                  String    @default("Professional")
  closerModel           String?   @map("closer_model")
  monthlyBudget         Decimal?  @db.Decimal(10,2) @map("monthly_budget")
  handoffRules          Json      @default("{}") @map("handoff_rules")

  // Personal voice-note greeting sent as the very first reply to a brand-new
  // contact, bypassing the Qualifier/Closer for that turn. welcomeVoiceFilePath
  // holds the converted .ogg used to silently re-upload a fresh media id when
  // the WhatsApp-issued one expires (~30 days) or a send rejects it.
  welcomeVoiceEnabled    Boolean   @default(false) @map("welcome_voice_enabled")
  welcomeVoiceMediaId    String?   @map("welcome_voice_media_id")
  welcomeVoiceFilePath   String?   @map("welcome_voice_file_path")
  welcomeVoiceUploadedAt DateTime? @map("welcome_voice_uploaded_at")

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  tenant                Tenant    @relation(fields: [tenantId], references: [id])

  @@map("ai_configs")
}

// ─────────────────────────────────────────────
// BILLING / SUBSCRIPTIONS
// ─────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(uuid())
  tenantId             String             @unique @map("tenant_id")
  stripeSubId          String?            @unique @map("stripe_sub_id")
  plan                 TenantPlan         @default(FREE)
  status               SubscriptionStatus @default(TRIALING)
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  contactsLimit        Int                @default(100) @map("contacts_limit")
  aiTokensLimit        BigInt             @default(100000) @map("ai_tokens_limit")
  aiTokensUsed         BigInt             @default(0) @map("ai_tokens_used")
  messagesLimit        Int                @default(1000) @map("messages_limit")
  messagesUsed         Int                @default(0) @map("messages_used")

  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  tenant               Tenant             @relation(fields: [tenantId], references: [id])

  @@map("subscriptions")
}

// ─────────────────────────────────────────────
// MANUAL PAYMENTS — bank transfer + screenshot
// ─────────────────────────────────────────────
//
// Stripe cannot receive payments for a Pakistani business, so clients pay by
// direct bank transfer and send a screenshot. Before this model there was no
// record of any of it: an admin could set tenant.plan by hand, but that wrote
// no amount, no date, no proof, and — critically — no currentPeriodEnd, so a
// paid plan never lapsed and nothing could be reconciled against the bank.
//
// Do NOT confuse this with the payment-proof fields on Conversation. Those are
// a *lead* paying a *tenant* over WhatsApp. This is a *tenant* paying us.
model ManualPayment {
  id             String              @id @default(uuid())
  tenantId       String              @map("tenant_id")

  // What the tenant says they paid.
  amount         Decimal             @db.Decimal(12, 2)
  currency       String              @default("PKR")
  paidAt         DateTime            @map("paid_at")
  reference      String?             // bank reference / transaction id

  // What it buys, applied on approval.
  plan           TenantPlan
  periodMonths   Int                 @default(1) @map("period_months")

  // The screenshot lives in the database on purpose. Railway's container
  // filesystem is ephemeral — anything written to /app/uploads is destroyed on
  // every redeploy — and a payment audit trail cannot evaporate. These are
  // small images and there are a handful per month; the size cap and MIME
  // allowlist are enforced at the route. Move to object storage if volume ever
  // makes this a problem.
  proofImage     Bytes?              @map("proof_image")
  proofMimeType  String?             @map("proof_mime_type")
  proofFilename  String?             @map("proof_filename")

  status         ManualPaymentStatus @default(PENDING)
  notes          String?             // tenant's own note
  reviewedById   String?             @map("reviewed_by_id")
  reviewedAt     DateTime?           @map("reviewed_at")
  reviewNote     String?             @map("review_note")   // rejection reason

  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([status, createdAt])
  @@map("manual_payments")
}
